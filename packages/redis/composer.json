{
    "name": "stero/shield-redis",
    "description": "Fail-open Redis storage for Shield.",
    "license": "proprietary",
    "require": {"php": "^8.5", "ext-mbstring": "*", "ext-redis": "*", "stero/shield": "dev-main"},
    "repositories": [{"type": "path", "url": "../core"}],
    "require-dev": {"pestphp/pest": "^5.3", "phpstan/phpstan": "^2.3", "laravel/pint": "^1.32"},
    "autoload": {"psr-4": {"Stero\\Shield\\Redis\\": "src/"}},
    "autoload-dev": {"psr-4": {"Stero\\Shield\\Redis\\Tests\\": "tests/"}},
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint",
        "lint:check": "pint --test",
        "check": ["@lint:check", "@analyse", "@test"]
    },
    "config": {"allow-plugins": {"pestphp/pest-plugin": true}}
}
