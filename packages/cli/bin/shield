#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloader = $_composer_autoload_path ?? __DIR__ . '/../vendor/autoload.php';
if (!is_file($autoloader)) {
    $autoloader = __DIR__ . '/../../../vendor/autoload.php';
}
if (!is_file($autoloader) || !is_readable($autoloader)) {
    fwrite(STDERR, "Error: run composer install first.\n");
    exit(1);
}

try {
    require $autoloader;
    exit(new Stero\Shield\CLI\Application()->run());
} catch (Throwable) {
    fwrite(STDERR, "Error: Unable to start Shield.\n");
    exit(1);
}
